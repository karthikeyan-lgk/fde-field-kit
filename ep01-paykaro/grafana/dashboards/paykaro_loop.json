{
  "uid": "paykaro-loop",
  "title": "PayKaro \u2014 the loop",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 41,
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "SMS vendor: accepted vs rejected for quota (per min)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"sms-vendor\", http_route=\"/v1/messages\"}[3m])) * 60",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "429"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "429 quota exceeded"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "200"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "displayName",
                "value": "200 accepted"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Support bot: chats and resend_otp calls (per min)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"support-bot\", http_route=\"/chat\"}[3m])) * 60",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "chats"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_client_request_duration_seconds_count{service_name=\"support-bot\", server_address=\"otp-service\"}[3m])) * 60",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "resend_otp calls"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_client_request_duration_seconds_count{service_name=\"support-bot\", server_address=\"openrouter.ai\"}[3m])) * 60",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "LLM calls"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        }
      }
    }
  ]
}